{
  "name": "miniapp-plugin-chucker",
  "version": "2.1.0",
  "description": "Native Mini Program (WeApp / TCMPP / Alipay / ByteDance) UI assets, inspector page and runtime for Chucker",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "miniprogram": "dist",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code-id-miniapp-labs/tarojs-plugin-chucker.git",
    "directory": "packages/miniapp-plugin-chucker"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "miniapp-plugin-chucker": "./dist/cli/index.js",
    "chucker": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "node ../../scripts/copy.js ../chucker/src/store.ts src/store.ts ../chucker/src/interceptor.ts src/interceptor.ts ../chucker/src/utils.ts src/utils.ts",
    "build": "tsc",
    "postbuild": "node ../../scripts/copy.js src/components dist/components src/pages dist/pages && node ../../scripts/minify.js dist",
    "watch": "tsc -w",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "miniapp",
    "chucker",
    "debug",
    "network",
    "weapp",
    "tcmpp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "miniapp-chucker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
