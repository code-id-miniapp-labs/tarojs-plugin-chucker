<!-- miniapp-chucker: Native Chucker Inspector Page -->
<view class="chucker-page">

  <!-- ══════════════════ LIST VIEW ══════════════════ -->
  <block wx:if="{{view === 'list'}}">
    <!-- Header -->
    <view class="header">
      <view class="header-left">
        <text class="header-title">Chucker</text>
        <view class="header-stats">
          <text class="stat-badge">{{logs.length}}</text>
          <text wx:if="{{errorCount > 0}}" class="stat-badge stat-badge--error">{{errorCount}} err</text>
        </view>
      </view>
      <view class="header-right">
        <view class="btn-clear" bindtap="onClear">
          <text class="btn-clear-text">Clear</text>
        </view>
      </view>
    </view>

    <!-- Toolbar: Filters + Search -->
    <view class="toolbar">
      <!-- Segmented filter tabs -->
      <view class="segmented-control">
        <view
          class="seg-item {{filterType === 'all' ? 'seg-item--active' : ''}}"
          bindtap="onSetFilter"
          data-type="all"
        >All</view>
        <view
          class="seg-item {{filterType === 'network' ? 'seg-item--active' : ''}}"
          bindtap="onSetFilter"
          data-type="network"
        >Network</view>
        <view
          class="seg-item {{filterType === 'native' ? 'seg-item--active' : ''}}"
          bindtap="onSetFilter"
          data-type="native"
        >Native</view>
      </view>

      <!-- Search bar -->
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="Filter URL, payload…"
          placeholder-class="search-placeholder"
          value="{{searchQuery}}"
          bindinput="onSearch"
        />
        <view wx:if="{{searchQuery}}" class="search-clear-btn" bindtap="onClearSearch">
          <text class="search-clear-icon">×</text>
        </view>
      </view>
    </view>

    <!-- Request List -->
    <scroll-view scroll-y class="log-scroll">
      <!-- Empty state -->
      <view wx:if="{{filteredLogs.length === 0}}" class="empty-state">
        <text class="empty-title">No transactions</text>
        <text class="empty-desc">Network requests and native calls appear here</text>
      </view>

      <!-- Log items -->
      <view
        wx:for="{{filteredLogs}}"
        wx:key="id"
        class="log-row {{item.statusClass === 'error' ? 'log-row--error' : item.statusClass === 'pending' ? 'log-row--pending' : ''}}"
        bindtap="onTapLog"
        data-id="{{item.id}}"
      >
        <!-- Badges column -->
        <view class="log-badges">
          <text class="method-tag method-tag--{{item.methodClass}}">{{item.method}}</text>
          <text class="status-code status-code--{{item.statusClass}}">{{item.status !== undefined ? item.status : '…'}}</text>
        </view>

        <!-- URL & Meta -->
        <view class="log-content">
          <text class="log-url">{{item.url}}</text>
          <view class="log-meta">
            <text class="log-time">{{item.timeLabel}}</text>
            <block wx:if="{{item.duration !== undefined}}">
              <text class="log-dot">·</text>
              <text class="log-duration">{{item.duration}}ms</text>
            </block>
          </view>
        </view>

        <!-- Right arrow -->
        <text class="log-chevron">›</text>
      </view>
    </scroll-view>
  </block>

  <!-- ══════════════════ DETAIL VIEW ══════════════════ -->
  <block wx:if="{{view === 'detail' && selectedLog}}">
    <!-- Detail Topbar -->
    <view class="detail-bar">
      <view class="btn-back" bindtap="onBack">
        <text class="btn-back-arrow">‹</text>
        <text class="btn-back-text">Back</text>
      </view>
      <view class="detail-title-wrap">
        <text class="detail-title">{{selectedLog.method}} {{selectedLog.url}}</text>
      </view>
      <view class="detail-actions">
        <view wx:if="{{selectedLog.isNetwork}}" class="btn-curl" bindtap="onCopyCurl">
          <text class="btn-curl-text">cURL</text>
        </view>
      </view>
    </view>

    <!-- Detail Sub-tabs -->
    <view class="detail-tabs">
      <view
        class="detail-tab {{detailTab === 'overview' ? 'detail-tab--active' : ''}}"
        bindtap="onSetDetailTab"
        data-tab="overview"
      >OVERVIEW</view>
      <view
        class="detail-tab {{detailTab === 'request' ? 'detail-tab--active' : ''}}"
        bindtap="onSetDetailTab"
        data-tab="request"
      >REQUEST</view>
      <view
        class="detail-tab {{detailTab === 'response' ? 'detail-tab--active' : ''}}"
        bindtap="onSetDetailTab"
        data-tab="response"
      >RESPONSE</view>
    </view>

    <!-- Detail Scroll Area -->
    <scroll-view scroll-y class="detail-scroll">

      <!-- ── 1. Overview ── -->
      <view wx:if="{{detailTab === 'overview'}}" class="tab-panel">
        <!-- Summary Strip -->
        <view class="summary-strip summary-strip--{{selectedLog.statusClass}}">
          <view class="summary-item">
            <text class="summary-sub">STATUS</text>
            <text class="summary-main status-code--{{selectedLog.statusClass}}">{{selectedLog.status !== undefined ? selectedLog.status : 'PENDING'}}</text>
          </view>
          <view wx:if="{{selectedLog.duration !== undefined}}" class="summary-item">
            <text class="summary-sub">LATENCY</text>
            <text class="summary-main">{{selectedLog.duration}}ms</text>
          </view>
          <view class="summary-item">
            <text class="summary-sub">METHOD</text>
            <text class="summary-main method-color--{{selectedLog.methodClass}}">{{selectedLog.method}}</text>
          </view>
        </view>

        <!-- Information Card -->
        <view class="card">
          <view class="card-row" bindtap="onCopyUrl">
            <text class="card-label">URL / Path</text>
            <view class="card-value-wrap">
              <text class="card-value-mono">{{selectedLog.url}}</text>
              <text class="card-hint">Tap to copy</text>
            </view>
          </view>
          <view class="card-row">
            <text class="card-label">Type</text>
            <text class="card-value">{{selectedLog.type === 'native' ? 'Native Plugin Call' : 'HTTP Network Request'}}</text>
          </view>
          <view class="card-row">
            <text class="card-label">Time Initiated</text>
            <text class="card-value">{{selectedLog.startTimeLabel}}</text>
          </view>
        </view>
      </view>

      <!-- ── 2. Request ── -->
      <view wx:if="{{detailTab === 'request'}}" class="tab-panel">
        <!-- Request Headers -->
        <view wx:if="{{selectedLog.requestHeadersText}}" class="card">
          <view class="card-header">
            <text class="card-header-title">Headers</text>
            <view class="btn-mini-copy" bindtap="onCopyRequestHeaders">
              <text class="btn-mini-copy-text">Copy</text>
            </view>
          </view>
          <view class="code-block">
            <text class="code-text code-text--headers">{{selectedLog.requestHeadersText}}</text>
          </view>
        </view>

        <!-- Request Body -->
        <view class="card">
          <view class="card-header">
            <text class="card-header-title">Payload Body</text>
            <view wx:if="{{selectedLog.requestDataText}}" class="btn-mini-copy" bindtap="onCopyRequestBody">
              <text class="btn-mini-copy-text">Copy</text>
            </view>
          </view>
          <view class="code-block">
            <text wx:if="{{selectedLog.requestDataText}}" class="code-text code-text--body">{{selectedLog.requestDataText}}</text>
            <text wx:else class="empty-code-note">No payload body</text>
          </view>
        </view>
      </view>

      <!-- ── 3. Response ── -->
      <view wx:if="{{detailTab === 'response'}}" class="tab-panel">
        <!-- Error Alert -->
        <view wx:if="{{selectedLog.error}}" class="error-box">
          <text class="error-box-title">Error Encountered</text>
          <text class="error-box-msg">{{selectedLog.error}}</text>
        </view>

        <!-- Response Headers -->
        <view wx:if="{{selectedLog.responseHeadersText}}" class="card">
          <view class="card-header">
            <text class="card-header-title">Headers</text>
            <view class="btn-mini-copy" bindtap="onCopyResponseHeaders">
              <text class="btn-mini-copy-text">Copy</text>
            </view>
          </view>
          <view class="code-block">
            <text class="code-text code-text--headers">{{selectedLog.responseHeadersText}}</text>
          </view>
        </view>

        <!-- Response Body -->
        <view class="card">
          <view class="card-header">
            <text class="card-header-title">Response Body</text>
            <view wx:if="{{selectedLog.responseDataText}}" class="btn-mini-copy" bindtap="onCopyResponseBody">
              <text class="btn-mini-copy-text">Copy</text>
            </view>
          </view>
          <view class="code-block">
            <text wx:if="{{selectedLog.responseDataText}}" class="code-text code-text--body">{{selectedLog.responseDataText}}</text>
            <text wx:else class="empty-code-note">Empty response body</text>
          </view>
        </view>
      </view>

    </scroll-view>
  </block>

</view>
