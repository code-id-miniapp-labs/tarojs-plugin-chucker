.chucker-float-btn {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 200rpx);
  right: 16px;
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: #18181b;
  border: 1px solid #3f3f46;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.chucker-float-label {
  font-size: 18px;
  font-weight: 700;
  color: #3b82f6;
  line-height: 1;
}
