.chucker-float-btn {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 200rpx);
  right: 15px;
  width: 46px;
  height: 46px;
  border-radius: 23px;
  background-color: rgba(30, 30, 30, 0.88);
  border: 1px solid rgba(201, 185, 154, 0.3);
  box-shadow: 0 0 0 4px rgba(201, 185, 154, 0.06), 0 8px 24px rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.chucker-float-label {
  font-size: 18px;
  font-weight: 700;
  color: #c9b99a;
  line-height: 1;
}
