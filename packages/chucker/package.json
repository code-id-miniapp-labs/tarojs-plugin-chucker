{
  "name": "miniapp-chucker",
  "version": "2.1.1",
  "description": "Headless framework-agnostic network debugger core for WeApp / TCMPP / Alipay / TaroJS miniapps",
  "keywords": [
    "chucker",
    "debug",
    "interceptor",
    "miniapp",
    "network",
    "taro",
    "tcmpp",
    "weapp"
  ],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-id-miniapp-labs/tarojs-plugin-chucker.git",
    "directory": "packages/chucker"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/index.js",
    "./utils": "./dist/utils.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node ../../scripts/minify.js dist",
    "watch": "tsc -w",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
